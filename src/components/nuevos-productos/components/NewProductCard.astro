---
// src/components/nuevos-productos/components/NewProductCard.astro
import type { Lang } from '../../../i18n/config.i18n';
import type { ProductProposal } from '../../../types/product';
import content from '../../../data/site-nuevos-productos-content.json';

interface Props {
  product: ProductProposal;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = content[lang] ?? content.es;
const detailHref = `/${lang}/nuevos-productos/${product.slug}`;

const isRevisado =
  product.revisado === true ||
  product.revisado === 'true' ||
  (typeof product.revisado === 'string' && product.revisado.trim().toLowerCase() === 'revisado');

const isAprobado =
  product.aprobado === true ||
  product.aprobado === 'true' ||
  (typeof product.aprobado === 'string' && product.aprobado.trim().toLowerCase() === 'aprobado');

const statusText = isAprobado
  ? (t.status?.approved ?? (lang === 'es' ? 'Aprobado' : 'Approved'))
  : (t.status?.rejected ?? (lang === 'es' ? 'No aprobado' : 'Not Approved'));
---

<article 
  class="group relative flex flex-col h-full bg-white border border-gray-200 rounded-sm shadow-xs hover:shadow-md hover:border-[#299898] transition-all duration-200 overflow-hidden"
  data-product-card
  data-category={product.clase_categoria}
  data-search={`${product.nombre_marca_del_producto} ${product.clase_categoria} ${product.proveedor_fabricante} ${product.procedencia} ${isRevisado ? statusText : ''}`.toLowerCase()}
>
  {/* Product Image in clean white framed container with light border */}
  <div class="relative w-full h-56 bg-white border-b border-gray-200 flex items-center justify-center p-4 overflow-hidden">
    {/* Status Chip (Aprobado / No aprobado) - Visible únicamente cuando 'revisado' es true */}
    {isRevisado && (
      <div class="absolute top-2.5 left-2.5 z-10 pointer-events-none">
        <span
          class:list={[
            "inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-sm shadow-xs border",
            isAprobado
              ? "bg-[#76b800] text-white border-[#6aa600]"
              : "bg-red-600 text-white border-red-700",
          ]}
        >
          {isAprobado ? (
            <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          ) : (
            <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          )}
          <span>{statusText}</span>
        </span>
      </div>
    )}

    <img
      src={product.image}
      alt={product.nombre_marca_del_producto}
      loading="lazy"
      class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
    />
    
    {/* Size / Presentation Badge */}
    <div class="absolute bottom-2.5 right-2.5 z-10 pointer-events-none">
      <span class="inline-block px-2 py-0.5 text-[11px] font-semibold text-gray-700 bg-gray-100/90 border border-gray-200 rounded-sm shadow-xs">
        {product.tamao}
      </span>
    </div>
  </div>

  {/* Card Body */}
  <div class="flex flex-col flex-1 p-5">
    
    {/* Category Badge */}
    <span class="text-[#0b3c61] font-bold text-[11px] uppercase tracking-wider block mb-1">
      {product.clase_categoria}
    </span>

    {/* Product Title */}
    <h3 class="text-base font-bold text-[#0b3c61] hover:text-[#299898] transition-colors leading-snug line-clamp-2">
      <a href={detailHref}>
        <span class="absolute inset-0 z-0"></span>
        {product.nombre_marca_del_producto}
      </a>
    </h3>

    {/* Metadata: Origin & Supplier */}
    <div class="mt-2 flex items-center gap-1.5 text-xs text-gray-500">
      <span class="inline-flex items-center gap-1 font-medium text-gray-700">
        <svg class="w-3.5 h-3.5 text-[#299898] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {product.procedencia}
      </span>
      <span class="text-gray-300">•</span>
      <span class="truncate">
        <span class="text-gray-400 font-normal">{lang === 'es' ? 'Fabricante:' : 'Supplier:'}</span> {product.proveedor_fabricante}
      </span>
    </div>

    {/* Financial Indicators Grid */}
    <div class="mt-4 bg-[#f8f9fa] border border-gray-200 rounded-sm p-3">
      <div class="grid grid-cols-3 gap-2 pb-2.5 border-b border-gray-200 text-center">
        <div class="text-left">
          <span class="block text-[10px] uppercase font-bold text-gray-500 tracking-wider">
            {lang === 'es' ? 'Costo Prov.' : 'Cost'}
          </span>
          <span class="mt-0.5 block text-xs sm:text-sm font-bold text-[#0b3c61]">
            {product.precio_de_compra_al_proveedor}
          </span>
        </div>
        <div class="text-left">
          <span class="block text-[10px] uppercase font-bold text-gray-500 tracking-wider">
            {lang === 'es' ? 'Venta Sug.' : 'Suggested'}
          </span>
          <span class="mt-0.5 block text-xs sm:text-sm font-bold text-[#0b3c61]">
            {product.precio_sugerido_cajaunidad}
          </span>
        </div>
        <div class="text-right">
          <span class="block text-[10px] uppercase font-bold text-gray-500 tracking-wider">
            {lang === 'es' ? 'Margen' : 'Margin'}
          </span>
          <span class="mt-0.5 inline-block bg-[#76b800] text-white text-xs font-bold px-2 py-0.5 rounded-sm">
            {product.margen_sugerido}
          </span>
        </div>
      </div>

      {/* Rotation & Minimum Order */}
      <div class="pt-2 flex items-center justify-between text-[11px] text-gray-600">
        <span class="inline-flex items-center gap-1 truncate">
          <span class="text-gray-400 font-medium">{lang === 'es' ? 'Rotación:' : 'Turnover:'}</span>
          <span class="font-semibold text-gray-800">{product.rotacion_esperada}</span>
        </span>
        <span class="inline-flex items-center gap-1 text-right shrink-0">
          <span class="text-gray-400 font-medium">{lang === 'es' ? 'Mínimo:' : 'Min:'}</span>
          <span class="font-semibold text-gray-800">{product.minimo_compra}</span>
        </span>
      </div>
    </div>

    {/* Primary Action Button */}
    <div class="mt-auto pt-4">
      <a
        href={detailHref}
        class="relative z-10 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-[#76b800] hover:bg-[#6aa600] active:bg-[#5d9200] rounded-sm shadow-xs transition-colors"
      >
        <span>{t.actions.viewEvaluation}</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</article>
