---
// src/components/nuevos-productos/components/NewProductCard.astro
import type { Lang } from '../../../i18n/config.i18n';
import type { ProductProposal } from '../../../types/product';
import content from '../../../data/site-nuevos-productos-content.json';

interface Props {
  product: ProductProposal;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = content[lang] ?? content.es;
const detailHref = `/${lang}/nuevos-productos/${product.slug}`;
---

<article 
  class="group relative flex flex-col h-full rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-[#299898]/50 transition-all duration-300 overflow-hidden"
  data-product-card
  data-category={product.clase_categoria}
  data-search={`${product.nombre_marca_del_producto} ${product.clase_categoria} ${product.proveedor_fabricante} ${product.procedencia}`.toLowerCase()}
>
  {/* Image Container with Badges */}
  <div class="relative w-full aspect-4/3 overflow-hidden bg-slate-100 dark:bg-slate-800/80">
    <img
      src={product.image}
      alt={product.nombre_marca_del_producto}
      loading="lazy"
      class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
    />
    
    {/* Category Badge (Top Left) */}
    <div class="absolute top-3 left-3">
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-slate-900/80 text-white backdrop-blur-xs border border-white/10 shadow-sm">
        {product.clase_categoria}
      </span>
    </div>

    {/* Margin Badge (Top Right) */}
    <div class="absolute top-3 right-3">
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500 text-white shadow-md">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        <span>{product.margen_sugerido} {lang === 'es' ? 'Margen' : 'Margin'}</span>
      </span>
    </div>

    {/* Presentation / Size Pill (Bottom Left overlay) */}
    <div class="absolute bottom-3 left-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-950/70 text-slate-200 backdrop-blur-xs">
        {product.tamao}
      </span>
    </div>
  </div>

  {/* Card Body */}
  <div class="flex flex-col flex-1 p-5">
    
    {/* Product Name & Brand */}
    <h3 class="text-lg font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#299898] transition-colors leading-snug">
      <a href={detailHref}>
        <span class="absolute inset-0 z-0"></span>
        {product.nombre_marca_del_producto}
      </a>
    </h3>

    {/* Meta: Origin & Supplier */}
    <div class="mt-2 flex flex-wrap items-center gap-y-1 gap-x-2 text-xs text-slate-600 dark:text-slate-400">
      <span class="inline-flex items-center gap-1 font-medium text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-[#299898]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {product.procedencia}
      </span>
      <span>•</span>
      <span class="truncate font-medium">
        {product.proveedor_fabricante}
      </span>
    </div>

    {/* Divider */}
    <hr class="my-4 border-slate-100 dark:border-slate-800" />

    {/* Financial Metrics Mini-Grid */}
    <div class="grid grid-cols-2 gap-3 text-xs bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-slate-100 dark:border-slate-800/80">
      <div>
        <p class="text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold text-[10px]">
          {lang === 'es' ? 'Costo Proveedor' : 'Supplier Cost'}
        </p>
        <p class="mt-0.5 text-sm font-bold text-slate-900 dark:text-slate-100">
          {product.precio_de_compra_al_proveedor}
        </p>
      </div>
      <div>
        <p class="text-slate-500 dark:text-slate-400 uppercase tracking-wider font-semibold text-[10px]">
          {lang === 'es' ? 'Venta Sugerida' : 'Suggested Sale'}
        </p>
        <p class="mt-0.5 text-sm font-bold text-teal-600 dark:text-teal-400">
          {product.precio_sugerido_cajaunidad}
        </p>
      </div>
    </div>

    {/* Rotation & Order Info */}
    <div class="mt-3 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span class="inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="font-medium text-slate-700 dark:text-slate-300">{product.rotacion_esperada}</span>
      </span>
      <span class="text-[11px] text-slate-400">
        {product.minimo_compra}
      </span>
    </div>

    {/* Action Button */}
    <div class="mt-5 pt-2">
      <a
        href={detailHref}
        class="relative z-10 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-xl text-white bg-[#299898] hover:bg-[#217d7d] active:bg-[#1b6868] shadow-sm hover:shadow transition-all duration-200"
      >
        <span>{t.actions.viewEvaluation}</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</article>
