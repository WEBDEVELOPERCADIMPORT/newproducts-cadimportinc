---
// src/components/nuevos-productos/components/ProductProposalDetail.astro
import type { Lang } from '../../../i18n/config.i18n';
import type { ProductProposal } from '../../../types/product';
import content from '../../../data/site-nuevos-productos-content.json';

interface Props {
  product: ProductProposal;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = content[lang] ?? content.es;

const catalogHref = `/${lang}/nuevos-productos`;
const mailSubject = encodeURIComponent(
  lang === 'es'
    ? `Consulta Comercial: Propuesta ${product.nombre_marca_del_producto}`
    : `Commercial Inquiry: Proposal ${product.nombre_marca_del_producto}`
);
const mailBody = encodeURIComponent(
  lang === 'es'
    ? `Estimado equipo comercial de CAD Import Inc,\n\nMe interesa obtener más información sobre la propuesta de evaluación de "${product.nombre_marca_del_producto}" (Categoría: ${product.clase_categoria}).\n\nSaludos cordiales.`
    : `Dear CAD Import Inc Commercial Team,\n\nI am interested in obtaining further information regarding the evaluation proposal for "${product.nombre_marca_del_producto}" (Category: ${product.clase_categoria}).\n\nBest regards.`
);
const contactHref = `mailto:info@cadimportinc.com?subject=${mailSubject}&body=${mailBody}`;
---

<div class="product-proposal-container py-8 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  
  {/* Top Navigation & Breadcrumbs */}
  <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6 print:hidden">
    <a href={`/${lang}/`} class="hover:text-[#299898] transition-colors">
      {lang === 'es' ? 'Inicio' : 'Home'}
    </a>
    <span>/</span>
    <a href={catalogHref} class="hover:text-[#299898] transition-colors">
      {lang === 'es' ? 'Nuevos Productos' : 'New Products'}
    </a>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs sm:max-w-md">
      {product.nombre_marca_del_producto}
    </span>
  </nav>

  {/* Header Banner */}
  <header class="relative rounded-3xl bg-gradient-to-br from-slate-950 via-[#144242] to-slate-900 border border-teal-800/40 p-6 sm:p-8 md:p-10 text-white shadow-xl overflow-hidden mb-10">
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-[#299898]/20 blur-3xl rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/15 blur-3xl rounded-full pointer-events-none"></div>

    <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 backdrop-blur-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            {lang === 'es' ? 'Propuesta en Evaluación' : 'Proposal Under Evaluation'}
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#299898]/25 text-teal-200 border border-[#299898]/40">
            {product.clase_categoria}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight">
          {product.nombre_marca_del_producto}
        </h1>
        <p class="mt-2 text-sm sm:text-base text-teal-100/90 flex items-center gap-2">
          <span>{lang === 'es' ? 'Ficha Ejecutiva de Viabilidad y Pre-Factibilidad' : 'Executive Feasibility & Technical Evaluation Sheet'}</span>
          <span>•</span>
          <span>CAD Import Inc</span>
        </p>
      </div>

      {/* Action Toolbar */}
      <div class="flex flex-wrap items-center gap-3 print:hidden">
        <a
          href={catalogHref}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900/80 hover:bg-slate-800 text-slate-200 border border-slate-700/60 transition shadow-sm backdrop-blur-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{t.actions.backToProducts}</span>
        </a>

        <button
          type="button"
          data-action="print-sheet"
          class="cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-teal-800/60 hover:bg-teal-700/80 text-white border border-teal-600/40 transition shadow-sm backdrop-blur-xs"
          title={lang === 'es' ? 'Imprimir o guardar como PDF' : 'Print or save as PDF'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t.actions.downloadBrochure}</span>
        </button>

        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white shadow-md transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{t.actions.requestSample}</span>
        </a>
      </div>
    </div>
  </header>

  <div class="space-y-10">

    {/* ========================================================
        SECCIÓN 1: Identificación del producto
        ======================================================== */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
        <div class="w-8 h-8 rounded-xl bg-[#299898]/10 text-[#299898] flex items-center justify-center font-bold text-sm">
          1
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {t.sections.identification}
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* Product Image Frame */}
        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700/60 shadow-inner group">
            <img
              src={product.image}
              alt={product.nombre_marca_del_producto}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute bottom-3 right-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#299898] text-white shadow-md">
                {product.tamao}
              </span>
            </div>
          </div>
          <p class="mt-3 text-xs text-slate-500 dark:text-slate-400 text-center">
            {lang === 'es' ? 'Presentación oficial de muestra de importación' : 'Official import sample presentation'}
          </p>
        </div>

        {/* Specifications Data Grid */}
        <div class="lg:col-span-7">
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.nombre_marca_del_producto}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white">
                {product.nombre_marca_del_producto}
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.clase_categoria}
              </dt>
              <dd class="mt-1 text-base font-bold text-[#299898] dark:text-teal-400">
                {product.clase_categoria}
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.procedencia}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span>📍 {product.procedencia}</span>
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.proveedor_fabricante}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white">
                🏢 {product.proveedor_fabricante}
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.tamao}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white">
                ⚖️ {product.tamao}
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.cajas_por_unidad}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white">
                📦 {product.cajas_por_unidad} {lang === 'es' ? 'unidades / caja' : 'units / case'}
              </dd>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 sm:col-span-2">
              <dt class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                {t.fields.cajas_por_paleta}
              </dt>
              <dd class="mt-1 text-base font-bold text-slate-900 dark:text-white">
                🏗️ {product.cajas_por_paleta} {lang === 'es' ? 'cajas por paleta completa' : 'cases per full pallet'}
              </dd>
            </div>

          </dl>
        </div>
      </div>
    </section>

    {/* ========================================================
        SECCIÓN 2: Características principales
        ======================================================== */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
        <div class="w-8 h-8 rounded-xl bg-[#299898]/10 text-[#299898] flex items-center justify-center font-bold text-sm">
          2
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
          {t.sections.features}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Ingredients */}
        <div class="md:col-span-2 p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
          <h3 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">
            {t.fields.ingredientes}
          </h3>
          <div class="flex flex-wrap gap-2">
            {product.ingredientes.map((ingrediente) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {ingrediente}
              </span>
            ))}
          </div>
        </div>

        {/* Shelf Life & Certifications */}
        <div class="space-y-4">
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
            <h3 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              {t.fields.tiempo_de_vida}
            </h3>
            <p class="mt-1 text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-[#299898]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {product.tiempo_de_vida}
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-teal-50 dark:bg-teal-950/30 border border-teal-200 dark:border-teal-900/60">
            <h3 class="text-xs font-semibold text-teal-800 dark:text-teal-300 uppercase tracking-wider">
              {t.fields.certificaciones}
            </h3>
            <p class="mt-1 text-sm font-bold text-teal-950 dark:text-teal-100 flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              {product.certificaciones}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ========================================================
        SECCIÓN 3: Análisis del mercado y competencia
        ======================================================== */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
        <div class="w-8 h-8 rounded-xl bg-[#299898]/10 text-[#299898] flex items-center justify-center font-bold text-sm">
          3
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            {t.sections.marketAnalysis}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            {lang === 'es' ? 'Comparativa con alternativas vigentes en góndola' : 'Comparison against shelf alternatives currently on the market'}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        {/* Proposed Product Benchmark Card */}
        <div class="p-6 rounded-2xl bg-gradient-to-br from-teal-500/10 via-slate-50 to-slate-100 dark:from-teal-950/40 dark:via-slate-800/80 dark:to-slate-900 border-2 border-[#299898]/40 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#299898] text-white">
                ★ {lang === 'es' ? 'Nuestra Propuesta' : 'Our Proposal'}
              </span>
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">
                {product.margen_sugerido} {lang === 'es' ? 'Margen' : 'Margin'}
              </span>
            </div>

            <div class="flex items-center gap-4">
              <img
                src={product.image}
                alt={product.nombre_marca_del_producto}
                class="w-16 h-16 rounded-xl object-cover bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700"
              />
              <div>
                <h4 class="font-bold text-slate-900 dark:text-white text-base">
                  {product.nombre_marca_del_producto}
                </h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  {product.tamao} • {product.procedencia}
                </p>
              </div>
            </div>

            <div class="mt-6 space-y-2 border-t border-slate-200 dark:border-slate-700/60 pt-4 text-xs">
              <div class="flex justify-between text-slate-600 dark:text-slate-300">
                <span>{lang === 'es' ? 'Precio de compra (proveedor):' : 'Supplier purchase price:'}</span>
                <span class="font-bold text-slate-900 dark:text-white">{product.precio_de_compra_al_proveedor}</span>
              </div>
              <div class="flex justify-between text-slate-600 dark:text-slate-300">
                <span>{lang === 'es' ? 'Precio sugerido de venta:' : 'Suggested sale price:'}</span>
                <span class="font-bold text-teal-600 dark:text-teal-400">{product.precio_sugerido_cajaunidad}</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800 text-[11px] text-teal-800 dark:text-teal-300 font-medium">
            ✓ {lang === 'es' ? 'Ventaja en frescura, calidad y margen comercial directo.' : 'Advantage in freshness, quality, and direct commercial margin.'}
          </div>
        </div>

        {/* Competitor Cards */}
        <div class="space-y-4">
          <h3 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            {t.fields.competidores_directos}
          </h3>

          {product.competidores_directos && product.competidores_directos.length > 0 ? (
            product.competidores_directos.map((competitor) => (
              <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <img
                    src={competitor.image}
                    alt={competitor.nombre}
                    class="w-16 h-16 rounded-xl object-cover bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-700"
                    loading="lazy"
                  />
                  <div>
                    <span class="text-[10px] uppercase font-bold text-amber-600 dark:text-amber-400 tracking-wider">
                      {t.competitors.product}
                    </span>
                    <h4 class="font-bold text-slate-900 dark:text-white text-sm">
                      {competitor.nombre}
                    </h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                      {lang === 'es' ? 'En góndola supermercados' : 'Supermarket retail shelf'}
                    </p>
                  </div>
                </div>

                <div class="text-right">
                  <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">
                    {t.competitors.price}
                  </span>
                  <p class="text-base font-extrabold text-slate-900 dark:text-slate-100">
                    {competitor.precio}
                  </p>
                </div>
              </div>
            ))
          ) : (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 text-xs text-slate-400">
              {lang === 'es' ? 'Sin competidores directos registrados.' : 'No direct competitors registered.'}
            </div>
          )}
        </div>
      </div>
    </section>

    {/* ========================================================
        SECCIÓN 4: Análisis financiero preliminar
        ======================================================== */}
    <section class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
        <div class="w-8 h-8 rounded-xl bg-[#299898]/10 text-[#299898] flex items-center justify-center font-bold text-sm">
          4
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            {t.sections.financialAnalysis}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            {lang === 'es' ? 'Estructura de costos, precios proyectados y rentabilidad bruta' : 'Cost structure, projected pricing, and gross profitability'}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {/* Compra Proveedor */}
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
          <span class="text-[11px] font-semibold uppercase text-slate-500 dark:text-slate-400 tracking-wider">
            {t.fields.precio_de_compra_al_proveedor}
          </span>
          <p class="mt-2 text-xl font-black text-slate-900 dark:text-white">
            {product.precio_de_compra_al_proveedor}
          </p>
        </div>

        {/* Venta Sugerida */}
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
          <span class="text-[11px] font-semibold uppercase text-slate-500 dark:text-slate-400 tracking-wider">
            {t.fields.precio_sugerido_cajaunidad}
          </span>
          <p class="mt-2 text-xl font-black text-[#299898] dark:text-teal-400">
            {product.precio_sugerido_cajaunidad}
          </p>
        </div>

        {/* Margen Sugerido (Featured Highlight) */}
        <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-500/15 to-teal-500/10 border-2 border-emerald-500/40">
