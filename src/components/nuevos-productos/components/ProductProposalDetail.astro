{/* Client Script for Interactive Print Handler with astro:page-load */}
<script>
  function setupPrintActions() {
    const printButtons = document.querySelectorAll('[data-action="print-sheet"]');
    printButtons.forEach((btn) => {
      btn.removeEventListener('click', triggerPrint);
      btn.addEventListener('click', triggerPrint);
    });
  }

  function triggerPrint() {
    window.print();
  }

  setupPrintActions();
  document.addEventListener('astro:page-load', setupPrintActions);
</script>

<style>
  @media print {
    body {
      background-color: white !important;
      color: black !important;
    }
    .print\\:hidden {
      display: none !important;
    }
  }
</style>
