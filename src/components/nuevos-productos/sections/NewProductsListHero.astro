---
// src/components/nuevos-productos/sections/NewProductsListHero.astro
import type { Lang } from '../../../i18n/config.i18n';
import content from '../../../data/site-nuevos-productos-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang] ?? content.es;
---

<section class="relative min-h-[380px] sm:min-h-[460px] flex items-center overflow-hidden border-b-4 border-[#76b800] text-white">
  {/* Background Image */}
  <img
    src="/images/hero_inicio.png"
    alt="CAD Import Inc Hero"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
  />

  {/* Gradient Overlay: Deep navy on the left fading smoothly to transparent across the right */}
  <div class="absolute inset-0 bg-gradient-to-r from-[#0b3c61] via-[#0b3c61]/85 via-50% to-transparent"></div>

  {/* Content Container aligned to the left */}
  <div class="relative z-10 w-full px-6 sm:px-12 lg:px-16 py-16 sm:py-24">
    <div class="max-w-xl text-left">
      
      {/* Main Corporate Title */}
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight font-sans">
        {t.hero.title}
      </h1>

      {/* Corporate Subtitle */}
      <p class="mt-4 text-base sm:text-lg text-slate-100 leading-relaxed font-normal">
        {t.hero.subtitle}
      </p>

      {/* CTA Button */}
      <div class="mt-8">
        <a
          href="#products-grid"
          class="inline-flex items-center justify-center gap-2 px-7 py-3 text-sm font-bold uppercase tracking-wider text-white bg-[#76b800] hover:bg-[#6aa600] active:bg-[#5d9200] rounded-sm shadow-md transition-colors"
        >
          <span>{lang === 'es' ? 'COLABORA CON NOSOTROS' : 'PARTNER WITH US'}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
