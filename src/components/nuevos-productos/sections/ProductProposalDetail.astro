<script>
  function initCopyLink() {
    const copyBtn = document.getElementById('copy-product-link-btn');
    if (!copyBtn) return;

    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    const copyText = document.getElementById('copy-text');
    const defaultText = copyBtn.getAttribute('data-default-text') || 'Copiar enlace';
    const copiedText = copyBtn.getAttribute('data-copied-text') || '¡Enlace copiado!';

    let timeoutId: number | undefined;

    copyBtn.onclick = async () => {
      try {
        const url = window.location.href;
        await navigator.clipboard.writeText(url);

        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
        }
        if (copyText) {
          copyText.textContent = copiedText;
        }
        copyBtn.classList.add('bg-[#0b3c61]', 'border-white/30');
        copyBtn.classList.remove('bg-[#76b800]');

        if (timeoutId) window.clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          if (copyIcon && checkIcon) {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }
          if (copyText) {
            copyText.textContent = defaultText;
          }
          copyBtn.classList.remove('bg-[#0b3c61]', 'border-white/30');
          copyBtn.classList.add('bg-[#76b800]');
        }, 2500);
      } catch (err) {
        console.error('Error copying link to clipboard:', err);
      }
    };
  }

  initCopyLink();
  document.addEventListener('astro:page-load', initCopyLink);
</script>
