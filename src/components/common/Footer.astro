---
// src/components/common/Footer.astro
import type { Lang } from '../../i18n/config.i18n';
import { getLangFromUrl } from '../../i18n/utils.i18n';
import globalContent from '../../data/site-global-content.json';

interface Props {
  lang?: Lang;
}

const { lang: propLang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url);
const t = (globalContent[lang] ?? globalContent.es).footer;

// Tamaños fijos de los placeholders de tiendas (presentación)
const storeSizes: Record<string, string> = {
  vasalsuper: 'w-[140px] h-[50px]',
  amazon: 'w-[140px] h-[55px]',
};
---

<footer class="w-full bg-[#f7f7f7] mt-auto font-sans">
  <div class="w-full px-6 sm:px-10 lg:px-14 py-10 lg:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[80px_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] gap-x-8 lg:gap-x-10 gap-y-10">

      {/* Column 1: Logo + Social + NMSDC */}
      <div class="flex flex-col items-center gap-5">
        <a
          href={`/${lang}/`}
          class="block w-20 h-20 rounded-full bg-white border border-gray-200 overflow-hidden"
          aria-label={t.logo.alt}
        >
          <img src={t.logo.src} alt={t.logo.alt} class="w-full h-full object-contain" loading="lazy" />
        </a>

        <div class="flex items-center gap-3">
          {t.social.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
              class="w-[22px] h-[22px] rounded-[4px] bg-[#76b900] hover:bg-[#669f00] text-white flex items-center justify-center transition-colors"
            >
              {item.id === 'facebook' ? (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M14 8.5V6.8c0-.8.5-1 1-1h2.4V2.1L14.6 2C11.4 2 10.4 4 10.4 6.4v2.1H8v3.8h2.4V22H14v-9.7h3l.4-3.8H14z" />
                </svg>
              ) : (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
                </svg>
              )}
            </a>
          ))}
        </div>

        {t.certification.src ? (
          <img src={t.certification.src} alt={t.certification.alt} class="w-20 h-20 object-contain" loading="lazy" />
        ) : (
          <div class="w-20 h-20" role="img" aria-label={t.certification.alt}></div>
        )}
      </div>

      {/* Column 2: Locations + Careers */}
      <div class="text-[13px] leading-relaxed text-[#333333]">
        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mb-4">{t.locations.title}</h3>
        <p>
          {t.locations.addressLine1}<br />
          {t.locations.addressLine2}
        </p>
        <p class="font-bold mt-4">{t.locations.schedule}</p>
        <a href={t.locations.phoneHref} class="inline-block mt-4 font-bold text-[#7cb82f] hover:text-[#5f9420] transition-colors">
          {t.locations.phone}
        </a>

        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mt-8 mb-4">{t.careers.title}</h3>
        <a href={t.careers.href} class="font-bold text-[#7cb82f] hover:text-[#5f9420] transition-colors">
          {t.careers.linkLabel}
        </a>
      </div>

      {/* Column 3: Newsletter */}
      <div>
        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] mb-2">{t.newsletter.title}</h3>
        <form class="footer-newsletter-form flex flex-col gap-3" data-success={t.newsletter.success}>
          <input
            type="text"
            name="firstName"
            placeholder={t.newsletter.namePlaceholder}
            aria-label={t.newsletter.namePlaceholder}
            class="w-full h-[26px] px-2.5 text-[11px] text-gray-700 placeholder:text-gray-500 bg-white border border-gray-300 rounded-[3px] focus:outline-none focus:border-[#1bbf5c]"
          />
          <div class="relative mt-2">
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-500 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="1.5" />
              <path d="M3.5 6l8.5 7 8.5-7" />
            </svg>
            <input
              type="email"
              name="email"
              required
              placeholder={t.newsletter.emailPlaceholder}
              aria-label={t.newsletter.emailPlaceholder}
              class="w-full h-[26px] pl-8 pr-2.5 text-[11px] text-gray-700 placeholder:text-gray-500 bg-white border border-gray-300 rounded-[3px] focus:outline-none focus:border-[#1bbf5c]"
            />
          </div>
          <div class="relative mt-2">
            <select
              name="language"
              aria-label={t.newsletter.languagePlaceholder}
              class="appearance-none w-full h-[30px] pl-2.5 pr-8 text-[11px] text-gray-600 bg-white border border-gray-300 rounded-[3px] focus:outline-none focus:border-[#1bbf5c] cursor-pointer"
            >
              <option value="" selected disabled>{t.newsletter.languagePlaceholder}</option>
              {t.newsletter.languageOptions.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-2.5 h-2.5 text-gray-500 pointer-events-none" viewBox="0 0 10 6" fill="currentColor" aria-hidden="true">
              <path d="M0 0h10L5 6z" />
            </svg>
          </div>
          <button
            type="submit"
            class="mt-4 w-full h-[32px] text-[12px] text-white bg-[#1bbf5c] hover:bg-[#17a84f] rounded-[3px] transition-colors cursor-pointer"
          >
            {t.newsletter.submit}
          </button>
        </form>
      </div>

      {/* Column 4: Exclusive product lines */}
      <div class="flex flex-col items-center text-center">
        <h3 class="text-[13px] font-bold uppercase text-[#0b3c61] leading-snug max-w-[220px] mb-4">{t.stores.title}</h3>
        <div class="flex flex-col items-center gap-4">
          {t.stores.items.map((store) => (
            <a
              href={store.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={store.alt}
              class={`block ${storeSizes[store.id] ?? 'w-[140px] h-[50px]'}`}
            >
              {store.src ? (
                <img src={store.src} alt={store.alt} class="w-full h-full object-contain" loading="lazy" />
              ) : (
                <span class="block w-full h-full"></span>
              )}
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</footer>

<script>
  function initFooterNewsletter() {
    document.querySelectorAll<HTMLFormElement>('.footer-newsletter-form').forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!button) return;
        const original = button.textContent ?? '';
        button.textContent = form.dataset.success ?? original;
        form.reset();
        window.setTimeout(() => {
          button.textContent = original;
        }, 3000);
      });
    });
  }
  initFooterNewsletter();
  document.addEventListener('astro:page-load', initFooterNewsletter);
</script>
