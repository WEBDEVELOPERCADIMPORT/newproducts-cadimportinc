---
// src/pages/[lang]/nuevos-productos/index.astro
import Layout from '../../../layouts/Layout.astro';
import { LANGUAGES, type Lang } from '../../../i18n/config.i18n';
import content from '../../../data/site-nuevos-productos-content.json';
import { actions } from 'astro:actions';
import NewProductsListHero from '../../../components/nuevos-productos/sections/NewProductsListHero.astro';
import NewProductCard from '../../../components/nuevos-productos/components/NewProductCard.astro';
import type { ProductProposal } from '../../../types/product';

const lang = Astro.params.lang as Lang;

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in content)) {
  return Astro.redirect('/404');
}

const t = content[lang];

// 2. Ejecutar Server Action para obtener los productos
const { data: response } = await Astro.callAction(actions.getNewProducts, { lang });
const products: ProductProposal[] = response?.data ?? [];

// Extraer categorías únicas para el filtro
const categories = Array.from(new Set(products.map((p) => p.clase_categoria))).filter(Boolean);
---

<Layout
  title={t.meta.title}
  lang={lang}
  description={t.meta.description}
  canonicalPath={`/${lang}/nuevos-productos`}
>
  {/* Hero Section */}
  <NewProductsListHero lang={lang} />

  {/* Catalog Section with Realtime Filtering */}
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    {/* Filter & Search Bar Header */}
    <div class="mb-10 p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        
        <div>
          <h2 class="text-2xl font-black text-slate-900 dark:text-white">
            {t.catalog.title}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            {t.catalog.subtitle}
          </p>
        </div>

        {/* Counter Badge */}
        <div class="inline-flex items-center gap-2 self-start md:self-auto px-3.5 py-1.5 rounded-xl bg-teal-50 dark:bg-teal-950/40 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-900/50 text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>
            <span id="filter-count">{products.length}</span> {lang === 'es' ? 'propuestas disponibles' : 'proposals available'}
          </span>
        </div>

      </div>

      {/* Filter Controls */}
      <div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-4">
        
        {/* Text Search Input */}
        <div class="md:col-span-7 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="filter-search"
            placeholder={t.catalog.filterPlaceholder}
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-[#299898] transition"
          />
        </div>

        {/* Category Dropdown Select */}
        <div class="md:col-span-5 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
          </div>
          <select
            id="filter-category"
            class="w-full pl-10 pr-8 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-[#299898] appearance-none transition cursor-pointer"
          >
            <option value="all">{t.catalog.allCategories}</option>
            {categories.map((cat) => (
              <option value={cat.toLowerCase()}>{cat}</option>
            ))}
          </select>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

      </div>

      {/* Category Pills (Quick Access) */}
      {categories.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
          <button
            type="button"
            data-category-pill="all"
            class="category-pill active-pill px-3 py-1 rounded-lg text-xs font-semibold bg-[#299898] text-white transition cursor-pointer"
          >
            {t.catalog.allCategories}
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-category-pill={cat.toLowerCase()}
              class="category-pill px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition cursor-pointer"
            >
              {cat}
            </button>
          ))}
        </div>
      )}

    </div>

    {/* Products Grid */}
    {products.length > 0 ? (
      <div 
        id="products-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        {products.map((product) => (
          <NewProductCard product={product} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500">
        <p class="text-base font-semibold">{t.catalog.empty}</p>
      </div>
    )}

    {/* Filter Empty State (Shown via JS when filtering has 0 matches) */}
    <div 
      id="filter-empty"
      class="hidden p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-500 mt-6"
    >
      <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white">
        {lang === 'es' ? 'No se encontraron resultados' : 'No matching results found'}
      </h3>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        {lang === 'es' ? 'Prueba con otros términos de búsqueda o selecciona otra categoría.' : 'Try adjusting your search query or selecting a different category.'}
      </p>
    </div>

  </section>
</Layout>

{/* Client-Side Search and Category Filter with astro:page-load */}
<script>
  function initProductFilter() {
    const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
    const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
    const cards = document.querySelectorAll<HTMLElement>('[data-product-card]');
    const countDisplay = document.getElementById('filter-count');
    const emptyState = document.getElementById('filter-empty');
    const pills = document.querySelectorAll<HTMLButtonElement>('[data-category-pill]');

    if (!cards.length) return;

    function applyFilter() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const selectedCategory = (categorySelect?.value ?? 'all').toLowerCase();

      let visibleCount = 0;

      cards.forEach((card) => {
        const cardSearch = (card.getAttribute('data-search') ?? '').toLowerCase();
        const cardCategory = (card.getAttribute('data-category') ?? '').toLowerCase();

        const matchesQuery = !query || cardSearch.includes(query);
        const matchesCategory = selectedCategory === 'all' || cardCategory === selectedCategory;

        if (matchesQuery && matchesCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) {
        countDisplay.textContent = visibleCount.toString();
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', applyFilter);

    categorySelect?.addEventListener('change', () => {
      const selectedVal = (categorySelect.value ?? 'all').toLowerCase();
      // Sync pills visual state
      pills.forEach((p) => {
        const pillCat = (p.getAttribute('data-category-pill') || 'all').toLowerCase();
        if (pillCat === selectedVal) {
          p.classList.add('bg-[#299898]', 'text-white');
          p.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        } else {
          p.classList.remove('bg-[#299898]', 'text-white');
          p.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        }
      });
      applyFilter();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetCategory = (pill.getAttribute('data-category-pill') || 'all').toLowerCase();
        if (categorySelect) {
          categorySelect.value = targetCategory;
        }
        pills.forEach((p) => {
          p.classList.remove('bg-[#299898]', 'text-white');
          p.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        pill.classList.add('bg-[#299898]', 'text-white');
        pill.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        applyFilter();
      });
    });
  }

  initProductFilter();
  document.addEventListener('astro:page-load', initProductFilter);
</script>
