---
// src/pages/[lang]/index.astro
import Layout from '../../layouts/Layout.astro';
import { LANGUAGES, type Lang } from '../../i18n/config.i18n';
import content from '../../data/site-nuevos-productos-content.json';
import { actions } from 'astro:actions';
import NewProductsListHero from '../../components/nuevos-productos/sections/NewProductsListHero.astro';
import NewProductsCatalog from '../../components/nuevos-productos/sections/NewProductsCatalog.astro';
import type { ProductProposal } from '../../types/product';

const lang = Astro.params.lang as Lang;

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in content)) {
  return Astro.redirect('/404');
}

const t = content[lang];

// 2. Extraer parámetro de categoría si existe
const categoryParam = Astro.url.searchParams.get('category');
const hasCategoryFilter = Boolean(categoryParam && categoryParam.trim().toLowerCase() !== 'all');

let products: ProductProposal[] = [];

if (hasCategoryFilter && categoryParam) {
  const { data: response } = await Astro.callAction(actions.getProductsByCategory, {
    category: categoryParam,
    lang,
  });
  products = response?.data ?? [];
} else {
  const { data: response } = await Astro.callAction(actions.getNewProducts, { lang });
  products = response?.data ?? [];
}

// Extraer categorías únicas para el filtro
let allProductsForCategories = products;
if (hasCategoryFilter) {
  const { data: allResponse } = await Astro.callAction(actions.getNewProducts, { lang });
  allProductsForCategories = allResponse?.data ?? products;
}
const categories = Array.from(new Set(allProductsForCategories.map((p) => p.clase_categoria))).filter(Boolean);
---

<Layout
  title={t.meta.title}
  lang={lang}
  description={t.meta.description}
  canonicalPath={`/${lang}/`}
>
  {/* Hero Section */}
  <NewProductsListHero lang={lang} />

  {/* Catalog Section with Realtime Filtering */}
  <NewProductsCatalog products={products} categories={categories} lang={lang} />
</Layout>
